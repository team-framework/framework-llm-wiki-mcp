# Absolute server path of the separately maintained framework-llm-wiki checkout
WIKI_HOST_PATH=/srv/framework-llm-wiki
# GitHub App: Framework Wiki MCP. This enables browser-based MCP OAuth login; never commit either secret below.
GITHUB_CLIENT_ID=Iv23liemylNHI43fwUN5
GITHUB_CLIENT_SECRET=paste-the-generated-client-secret-here
SESSION_SECRET=generate-a-long-random-value
ALLOWED_ORIGINS=https://framework-wiki.chaeyn.com
# Internal Hermes inference bridge; generate this on the server and share only with the wiki service.
HERMES_WIKI_KEY=generate-a-separate-random-value-at-least-32-characters
WIKI_PORT=3100
WIKI_WEB_PORT=3101
QDRANT_PORT=6336
EMBEDDING_PORT=8091
PUBLIC_BASE_URL=https://framework-wiki.chaeyn.com
WIKI_SERVICE_KEY=generate-a-separate-read-only-key-at-least-32-characters
# Existing volumes may be reused during a reviewed service migration.
QDRANT_VOLUME=framework-llm-wiki-mcp_qdrant-data
EMBEDDING_MODELS_VOLUME=framework-llm-wiki-mcp_embedding-models
EMBEDDING_CACHE_VOLUME=framework-llm-wiki-mcp_embedding-cache
WIKI_MEASUREMENT_SECRET=generate-a-separate-identity-hashing-secret-at-least-32-characters
WIKI_MEASUREMENT_RELEASE=deployment-git-commit
WIKI_MEASUREMENT_MODE=production
MEASUREMENT_VOLUME=framework-llm-wiki-mcp_measurement-data
CHAT_VOLUME=framework-llm-wiki-mcp_chat-data
# Framework Bot GitHub App installed on the canonical wiki; Contents and Pull requests write.
# Enable the read-only key mount after configuring the App and tracking issue:
# COMPOSE_FILE=compose.yaml:compose.wiki-updates.yaml
WIKI_GITHUB_REPOSITORY=team-framework/framework-llm-wiki
WIKI_GITHUB_APP_CLIENT_ID=
WIKI_GITHUB_APP_SLUG=framework-harness-sync
WIKI_GITHUB_APP_PRIVATE_KEY_HOST_PATH=/home/chaeyn/apps/framework-agent-harness-sync/private-key.pem
# Existing issue in the canonical wiki used for PR branch/title tracking.
WIKI_TRACKING_ISSUE=
# Optional read-only Notion Internal connection; share only the team root with this connection.
NOTION_TOKEN=
NOTION_ROOT_PAGE_IDS=30cba097c65980b5bddbfd0a67de936a
NOTION_INDEX_ENABLED=true
NOTION_INDEX_PATH=/cache/notion/index.json
NOTION_SYNC_INTERVAL_MS=600000
